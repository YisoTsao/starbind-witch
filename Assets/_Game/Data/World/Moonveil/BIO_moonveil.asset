  - id: edge_undergrowth
    sprites:
    - PROP_mv_bush_dark
    - PROP_mv_bush_green
    - PROP_mv_bush_flower
    - PROP_mv_bush_berry
    - PROP_mv_lavender
    - PROP_mv_bellflower
