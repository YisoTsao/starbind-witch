  speaker: "\u827E\u62C9"
  lines:
  - "\u9732\u7C73\uFF0C\u4F60\u4F86\u4E86\u3002\u9019\u7247\u6E56\u2026\u2026\u5012\u6620\u7684\u662F\u53E6\u4E00\u7247\u661F\u7A7A\u3002"
  - "\u6211\u5F97\u5411\u4F60\u5766\u767D\uFF1A\u5E74\u8F15\u6642\uFF0C\u662F\u6211\u7528\u6708\u5F71\u9B54\u6CD5\u5C01\u5370\u4E86\u90A3\u672C\u9B54\u5178\u3002\u5982\u4ECA\u5C01\u5370\u6B63\u5728\u5931\u6548\u3002"
  - "\u6E56\u5FC3\u7684\u5F71\u5B50\u6703\u6A21\u4EFF\u4F60\u7684\u9B54\u6CD5\u3002\u9EDE\u4EAE\u6D6E\u5CF6\u4E0A\u7684\u5C0E\u96FB\u5854\uFF0C\u5149\u6A4B\u5C31\u6703\u67B6\u8D77\u4F86\u2014\u2014\u897F\u908A\u6216\u6771\u908A\u90FD\u884C\u3002"
  linesAfterVictory:
