  m_EditorClassIdentifier: Starbind.Gameplay::Starbind.World.Talkable
  speaker: "\u51F1\u6069\uFF08\u9A0E\u58EB\uFF09"
  lines:
  - "\u4F86\u5F97\u6B63\u597D\uFF0C\u9B54\u5973\u3002\u6728\u5076\u4E0D\u6703\u5012\uFF0C\u76E1\u60C5\u6253\u5427\u3002"
  - "\u5DE6\u9375\u77ED\u6309\u662F\u4E09\u6BB5\u9023\u64CA\uFF1A\u5E73\u6383\u3001\u56DE\u8EAB\u6572\u64CA\u3001\u9B54\u529B\u9707\u64CA\u3002\u7B2C\u4E09\u6BB5\u80FD\u64CA\u9000\u6575\u4EBA\u4E26\u7D2F\u7A4D\u5171\u9CF4\u3002"
  - "\u6309\u4F4F\u5DE6\u9375\uFF08\u6216\u53F3\u9375\uFF09\u84C4\u529B\uFF0C\u653E\u958B\u5C04\u51FA\u9B54\u5F48\uFF0C\u84C4\u8D8A\u4E45\u8D8A\u5F37\u3002"
  - "Space \u9583\u907F\u6709\u7121\u6575\u6642\u9593\uFF1B\u5728\u6575\u4EBA\u653B\u64CA\u6253\u4E2D\u524D\u9583\u958B\uFF0C\u4E0B\u4E00\u767C\u9B54\u5F48\u6703\u8B8A\u5F37\u3002"
  - "\u8A66\u8A66\u706B\uFF08Q\uFF09\uFF0B\u98A8\uFF08E\uFF09\uFF1A\u98A8\u628A\u71C3\u71D2\u7684\u6575\u4EBA\u6372\u8D77\u4F86\uFF0C\u5C31\u662F\u706B\u7130\u9F8D\u6372\uFF01"
