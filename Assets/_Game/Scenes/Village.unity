--- !u!114 &123982008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 123982006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 965451cb1c3fc4c05b186f658613f99d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Starbind.Gameplay::Starbind.World.Talkable
  speaker: "\u51F1\u6069\uFF08\u9A0E\u58EB\uFF09"
  lines:
  - "\u4F86\u5F97\u6B63\u597D\uFF0C\u9B54\u5973\u3002\u6728\u5076\u4E0D\u6703\u5012\uFF0C\u76E1\u60C5\u6253\u5427\u3002"
  - "\u5DE6\u9375\u77ED\u6309\u662F\u4E09\u6BB5\u9023\u64CA\uFF1A\u5E73\u6383\u3001\u56DE\u8EAB\u6572\u64CA\u3001\u9B54\u529B\u9707\u64CA\u3002\u7B2C\u4E09\u6BB5\u80FD\u64CA\u9000\u6575\u4EBA\u4E26\u7D2F\u7A4D\u5171\u9CF4\u3002"
  - "\u6309\u4F4F\u5DE6\u9375\uFF08\u6216\u53F3\u9375\uFF09\u84C4\u529B\uFF0C\u653E\u958B\u5C04\u51FA\u9B54\u5F48\uFF0C\u84C4\u8D8A\u4E45\u8D8A\u5F37\u3002"
  - "Space \u9583\u907F\u6709\u7121\u6575\u6642\u9593\uFF1B\u5728\u6575\u4EBA\u653B\u64CA\u6253\u4E2D\u524D\u9583\u958B\uFF0C\u4E0B\u4E00\u767C\u9B54\u5F48\u6703\u8B8A\u5F37\u3002"
  - "\u8A66\u8A66\u706B\uFF08Q\uFF09\uFF0B\u98A8\uFF08E\uFF09\uFF1A\u98A8\u628A\u71C3\u71D2\u7684\u6575\u4EBA\u6372\u8D77\u4F86\uFF0C\u5C31\u662F\u706B\u7130\u9F8D\u6372\uFF01"
  linesAfterVictory: []
  questId: talked_kain
  healsPlayer: 0
  stages:
  - flag: talked_ella_mine
    quest: talked_kain_mine
    lines:
    - "\u7926\u5751\uFF1F\u6211\u5E74\u8F15\u6642\u5728\u90A3\u88E1\u7576\u904E\u8B77\u885B\u3002"
    - "\u5165\u53E3\u7684\u7926\u8ECA\u9084\u80FD\u7528\u2014\u2014\u63A8\u5B83\u53BB\u649E\u843D\u77F3\uFF0C\u6BD4\u4F60\u7528\u6CD5\u6756\u6572\u5FEB\u591A\u4E86\u3002"
    - "\u6DF1\u8655\u7684\u6676\u6838\u9B54\u50CF\u6703\u5438\u6536\u96F7\u96FB\uFF0C\u96F7\u7CFB\u6CD5\u8853\u6253\u5B83\u53EA\u6703\u8B93\u5B83\u904E\u8F09\u3002\u904E\u8F09\u4E4B\u5F8C\u5B83\u7684\u6838\u5FC3\u6703\u88C2\u958B\uFF0C\u90A3\u624D\u662F\u6A5F\u6703\u3002"
    - "\u5F9E\u50B3\u9001\u661F\u76E4\u9078\u300C\u661F\u6838\u7926\u5751\u300D\u3002\u6211\u5728\u6751\u5B50\u88E1\u7B49\u4F60\u7684\u597D\u6D88\u606F\u3002"
  - flag: defeat_crystal_golem
    quest: 
    lines:
    - "\u4F60\u6253\u5012\u4E86\u6676\u6838\u9B54\u50CF\uFF1F\u54C8\uFF01\u6211\u5C31\u77E5\u9053\u3002"
    - "\u7A1C\u5149\u5C04\u7DDA\u90A3\u62DB\u4E0D\u932F\uFF0C\u4E00\u6574\u6392\u6575\u4EBA\u4E00\u6B21\u8CAB\u7A7F\u3002"
  reward: 
  requiresFlag: 
  linesLocked: []
