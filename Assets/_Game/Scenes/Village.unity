--- !u!114 &816751654
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 816751652}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 965451cb1c3fc4c05b186f658613f99d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Starbind.Gameplay::Starbind.World.Talkable
  speaker: "\u6D1B\u6069\uFF08\u5F13\u7BAD\u624B\uFF09"
  lines:
  - "\u68EE\u6797\u7684\u8DEF\u6211\u6700\u719F\u3002\u5165\u53E3\u6709\u53F2\u840A\u59C6\uFF0C\u8611\u83C7\u6797\u9053\u7684\u6BD2\u5B62\u83C7\u6703\u5F9E\u9060\u8655\u5410\u5B62\u5B50\u3002"
  - "\u661F\u75D5\u796D\u58C7\u6309 F \u6703\u559A\u4F86\u602A\u6F6E\uFF0C\u6490\u904E\u53BB\u6709\u66F8\u9801\u734E\u52F5\u3002"
  - "\u65B7\u88C2\u77F3\u6A4B\u65C1\u6709\u62C9\u687F\u53EF\u4EE5\u4FEE\u6A4B\uFF1B\u6A4B\u908A\u7684\u85E4\u8513\u7528\u706B\u71D2\u6389\u80FD\u8D70\u6377\u5F91\u3002"
  - "\u6A39\u6839\u5B88\u885B\u885D\u92D2\u524D\u5730\u4E0A\u6703\u51FA\u73FE\u7D05\u8272\u8B66\u793A\uFF0C\u5F80\u5074\u908A\u9583\uFF01"
  linesAfterVictory: []
  questId: 
  healsPlayer: 0
  stages:
  - flag: defeat_mushroom_king
    quest: 
    lines:
    - "\u7926\u5751\u88E1\u6709\u4E00\u7A2E\u6676\u87CE\uFF0C\u6703\u885D\u904E\u4F86\u81EA\u7206\u3002\u770B\u5230\u5730\u4E0A\u7684\u5149\u5708\u5C31\u9583\u958B\uFF01"
    - "\u7926\u5751\u897F\u908A\u6709\u689D\u6B7B\u5DF7\uFF0C\u807D\u8AAA\u6709\u7926\u5DE5\u88AB\u56F0\u5728\u88E1\u9762\u3002"
  - flag: defeat_crystal_golem
    quest: 
    lines:
    - "\u661F\u8F1D\u6E56\u7684\u6D6E\u5CF6\u4E4B\u9593\u6C92\u6709\u8DEF\uFF0C\u5F97\u9760\u5C0E\u96FB\u5854\u67B6\u8D77\u5149\u6A4B\u3002"
    - "\u897F\u908A\u6216\u6771\u908A\u7684\u5149\u6A4B\u90FD\u901A\u5F80\u6C34\u6676\u907A\u8DE1\uFF0C\u9078\u4E00\u908A\u5C31\u597D\u3002"
  - flag: defeat_lake_shadow
    quest: 
    lines:
    - "\u89C0\u661F\u53F0\u5728\u96EA\u5C71\u4E0A\u3002\u96EA\u9053\u65C1\u6709\u5EA7\u5C0F\u5C4B\uFF0C\u64DA\u8AAA\u7559\u8457\u5F88\u4E45\u4EE5\u524D\u7684\u89C0\u6E2C\u7D00\u9304\u3002"
  reward: 
  requiresFlag: 
  linesLocked: []
