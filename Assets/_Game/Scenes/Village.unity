--- !u!114 &817467176
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 817467174}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 965451cb1c3fc4c05b186f658613f99d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Starbind.Gameplay::Starbind.World.Talkable
  speaker: "\u827E\u62C9"
  lines:
  - "\u9732\u7C73\uFF0C\u9B54\u5178\u7684\u66F8\u9801\u5728\u767C\u5149\u2026\u2026\u9019\u4E0D\u662F\u597D\u5146\u982D\u3002"
  - "\u5148\u53BB\u6771\u5357\u908A\u7684\u8A13\u7DF4\u5834\u627E\u51F1\u6069\uFF0C\u7DF4\u7FD2\u6CD5\u6756\u9023\u64CA\uFF08\u5DE6\u9375\uFF09\u3001\u84C4\u529B\u9B54\u5F48\uFF08\u6309\u4F4F\u5DE6\u9375\u6216\u53F3\u9375\uFF09\u8207\u9583\u907F\uFF08Space\uFF09\u3002"
  - "\u6E96\u5099\u597D\u4E86\u5C31\u5F9E\u5357\u908A\u5C0F\u8DEF\u9032\u5165\u6708\u5F71\u68EE\u6797\u3002\u68EE\u6797\u6DF1\u8655\u7684\u6708\u8755\u83C7\u738B\u5C31\u662F\u7570\u5E38\u7684\u6E90\u982D\u3002"
  - "\u5C0F\u5C4B\u88E1\u7684\u9B54\u5178\u53F0\u53EF\u4EE5\u66F4\u63DB Q / E \u6CD5\u8853\uFF1B\u7814\u7A76\u684C\u80FD\u7528\u68EE\u6797\u5E36\u56DE\u7684\u6750\u6599\u505A\u6C38\u4E45\u7814\u7A76\u3002"
  linesAfterVictory:
  - "\u4F60\u771F\u7684\u6253\u5012\u4E86\u83C7\u738B\uFF01\u9B54\u5178\u6B98\u9801\u4E0A\u7684\u661F\u75D5\u53C8\u4EAE\u4E86\u4E00\u4E9B\u3002"
  - "\u7528\u5E36\u56DE\u7684\u661F\u7802\u5230\u7814\u7A76\u684C\u89E3\u9396\u65B0\u66F8\u9801\u5427\uFF0C\u4E0B\u4E00\u6B21\u53EF\u4EE5\u5617\u8A66\u4E0D\u540C\u7684\u69CB\u7BC9\u3002"
  questId: talked_ella
  healsPlayer: 0
  stages:
  - flag: defeat_mushroom_king
    quest: talked_ella_mine
    lines:
    - "\u4F60\u771F\u7684\u6253\u5012\u4E86\u83C7\u738B\uFF01\u770B\u770B\u9019\u5F35\u6B98\u9801\u2014\u2014\u4E0A\u9762\u756B\u8457\u4E00\u5F35\u661F\u5716\u3002"
    - "\u661F\u5716\u6307\u5411\u6771\u908A\u5C71\u88E1\u7684\u661F\u6838\u7926\u5751\u3002\u90A3\u88E1\u7684\u661F\u6838\u7926\u8108\u88AB\u9B54\u5178\u7684\u529B\u91CF\u6539\u5BEB\u4E86\u3002"
    - "\u51F1\u6069\u8A8D\u5F97\u7926\u5751\u7684\u8DEF\u3002\u6E96\u5099\u597D\u4E86\uFF0C\u5C31\u5230\u50B3\u9001\u661F\u76E4\u9078\u64C7\u300C\u661F\u6838\u7926\u5751\u300D\u3002"
    - "\uFF08\u65B0\u529F\u80FD\uFF1A\u6309 J \u6253\u958B\u4EFB\u52D9\u65E5\u8A8C\u3002\uFF09"
  - flag: defeat_crystal_golem
    quest: 
    lines:
    - "\u6676\u6838\u9B54\u50CF\u5012\u4E0B\u4E86\uFF0C\u7926\u8108\u6B63\u5728\u6062\u5FA9\u3002\u4F60\u5E36\u56DE\u7684\u66F8\u9801\u8B93\u6211\u60F3\u8D77\u2026\u2026\u4E00\u4E9B\u820A\u4E8B\u3002"
    - "\u6211\u5148\u53BB\u661F\u8F1D\u6E56\u7684\u6E56\u7554\u71DF\u5730\u7B49\u4F60\u3002\u6709\u4E9B\u8A71\uFF0C\u6211\u60F3\u5728\u90A3\u88E1\u8AAA\u3002"
  - flag: defeat_lake_shadow
    quest: 
    lines:
    - "\u6E56\u5F71\u6D88\u6563\u4E86\u3002\u4F60\u5DF2\u7D93\u77E5\u9053\u5C01\u5370\u7684\u4E8B\u4E86\u2026\u2026\u8B1D\u8B1D\u4F60\u6C92\u6709\u8CAC\u602A\u6211\u3002"
    - "\u738B\u5B50\u5E36\u8457\u570B\u738B\u7684\u59D4\u8A17\u4F86\u627E\u4F60\u4E86\uFF0C\u53BB\u8A13\u7DF4\u5834\u90A3\u908A\u807D\u807D\u5427\u3002"
  - flag: defeat_star_guardian
    quest: talked_ella_citadel
    lines:
    - "\u770B\uFF0C\u5929\u4E0A\u7684\u6708\u4EAE\u88AB\u541E\u6389\u4E86\u4E00\u89D2\u3002\u6708\u8755\u964D\u81E8\u4E86\u3002"
    - "\u9B54\u5178\u7684\u610F\u5FD7\u5728\u5317\u65B9\u7684\u9ED1\u6708\u57CE\u585E\u6210\u5F62\u4E86\u3002\u5B83\u5206\u6210\u4E09\u500B\u5B78\u6D3E\uFF0C\u85CF\u5728\u4E09\u5EA7\u53E4\u5854\u88E1\u3002"
    - "\u9732\u7C73\uFF0C\u4E0D\u7BA1\u4F60\u6700\u5F8C\u600E\u9EBC\u9078\uFF0C\u6211\u90FD\u7AD9\u5728\u4F60\u9019\u908A\u3002\u5F9E\u50B3\u9001\u661F\u76E4\u51FA\u767C\u5427\u3002"
  - flag: ending_seal
    quest: 
    lines:
    - "\u9B54\u5178\u53C8\u7761\u8457\u4E86\u3002\u4F60\u505A\u5F97\u5F88\u597D\uFF0C\u9732\u7C73\u3002"
    - "\u5C31\u7B97\u4E0D\u80FD\u6539\u5BEB\u6CD5\u8853\uFF0C\u4F60\u4F9D\u7136\u662F\u661F\u9732\u6751\u6700\u597D\u7684\u9B54\u5973\u3002"
