  m_Script: {fileID: 11500000, guid: 965451cb1c3fc4c05b186f658613f99d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Starbind.Gameplay::Starbind.World.Talkable
  speaker: "\u738B\u5B50"
  lines:
  - "\u4F60\u5C31\u662F\u661F\u9732\u6751\u7684\u9B54\u5973\u5427\uFF1F\u6211\u5949\u7236\u738B\u4E4B\u547D\uFF0C\u4F86\u8ABF\u67E5\u6708\u5F71\u68EE\u6797\u7684\u7570\u8B8A\u3002"
  - "\u51F1\u6069\u662F\u6211\u7684\u528D\u8853\u8001\u5E2B\u3002\u4ED6\u8AAA\u9B54\u5973\u7684\u6CD5\u6756\u9023\u64CA\uFF0C\u53EF\u4E0D\u6BD4\u9A0E\u58EB\u7684\u528D\u6162\u3002"
  - "\u4F60\u9032\u68EE\u6797\u7684\u6642\u5019\uFF0C\u6211\u6703\u5B88\u4F4F\u6751\u5B50\u3002\u7B49\u4F60\u5E36\u8457\u597D\u6D88\u606F\u56DE\u4F86\u3002"
  linesAfterVictory:
  - "\u6708\u8755\u83C7\u738B\u88AB\u6253\u5012\u4E86\uFF1F\u738B\u570B\u6B20\u4F60\u4E00\u4EFD\u5927\u6069\uFF0C\u9B54\u5973\u3002"
  - "\u4E0B\u6B21\u518D\u9032\u68EE\u6797\uFF0C\u63DB\u500B\u9B54\u5178\u69CB\u7BC9\u8A66\u8A66\u5427\u3002\u6211\u6703\u5728\u9019\u88E1\u7B49\u4F60\u7684\u6545\u4E8B\u3002"
  questId: 
  healsPlayer: 0
  stages:
  - flag: defeat_lake_shadow
    quest: talked_prince_observatory
    lines:
    - "\u9B54\u5973\uFF0C\u7236\u738B\u6709\u4E00\u9805\u59D4\u8A17\uFF1A\u8ABF\u67E5\u5317\u65B9\u5C71\u4E0A\u7684\u5931\u843D\u89C0\u661F\u53F0\u3002"
    - "\u50B3\u8AAA\u90A3\u88E1\u8A18\u9304\u8457\u7B2C\u4E00\u4F4D\u661F\u75D5\u9B54\u5973\u7684\u7814\u7A76\u2014\u2014\u4E5F\u8A31\u80FD\u89E3\u91CB\u9B54\u5178\u70BA\u4EC0\u9EBC\u5931\u63A7\u3002"
    - "\u89C0\u661F\u53F0\u7684\u5B88\u8B77\u8005\u6703\u7528\u6298\u5C04\u7684\u661F\u5149\u653B\u64CA\u3002\u5F9E\u50B3\u9001\u661F\u76E4\u51FA\u767C\u5427\uFF0C\u6211\u6703\u5411\u7236\u738B\u7A1F\u5831\u4F60\u7684\u529F\u7E3E\u3002"
  - flag: defeat_star_guardian
    quest: 
    lines:
    - "\u4F60\u5F9E\u89C0\u661F\u53F0\u56DE\u4F86\u4E86\uFF01\u5929\u4E0A\u7684\u6708\u4EAE\u2026\u2026\u90A3\u662F\u6708\u8755\u55CE\uFF1F"
    - "\u6211\u6703\u5B88\u4F4F\u6751\u5B50\u3002\u53BB\u5427\uFF0C\u9B54\u5973\uFF0C\u7D50\u675F\u9019\u4E00\u5207\u3002"
  - flag: story_complete
    quest: 
    lines:
    - "\u738B\u570B\u6703\u8A18\u4F4F\u4F60\u7684\u540D\u5B57\uFF0C\u661F\u75D5\u9B54\u5973\u3002"
    - "\u82E5\u54EA\u5929\u53C8\u6709\u7570\u8B8A\uFF0C\u6211\u5011\u518D\u4E00\u8D77\u51FA\u767C\u3002"
